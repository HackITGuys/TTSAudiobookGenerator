# Copy to .env and fill in. Real environment variables take precedence.
MISTRAL_API_KEY=

# Optional: default voice id (see `tts-audiobook voices`); empty = API default.
MISTRAL_TTS_VOICE=
# Optional: voices used with --author-gender female|male
MISTRAL_TTS_VOICE_FEMALE=
MISTRAL_TTS_VOICE_MALE=
# Optional: override the model (default voxtral-mini-tts-2603)
MISTRAL_TTS_MODEL=
